{
  "name": "tenshillm",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "bun test tests",
    "test:watch": "bun test --watch tests",
    "test:coverage": "bun test --coverage tests",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:rust": "cargo fmt --manifest-path src-tauri/Cargo.toml -- --check && cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets --all-features -- -D warnings",
    "check": "bun run lint && bun run test && bun run build && bun run lint:rust && bun run test:rust"
  },
