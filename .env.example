# Copy this file to .env and replace every placeholder with local test data.
# Never commit .env. Base64 variables should decode to the supplied Markdown.
TENSILLM_PROVIDER_NAME="OpenCode Zen"
TENSILLM_PROVIDER_ENDPOINT="https://provider.example.com/v1/chat/completions"
TENSILLM_PROVIDER_API_KEY="replace-with-provider-key"
TENSILLM_PROVIDER_MODEL_ID="minimax-m3"
TENSILLM_PROVIDER_MODEL_NAME="MiniMax M3"
TENSILLM_PROVIDER_TOOLS="true"
TENSILLM_PROVIDER_VISION="true"

TENSILLM_CONTEXT7_NAME="context7"
TENSILLM_CONTEXT7_URL="https://mcp.context7.com/mcp"
TENSILLM_CONTEXT7_HEADER_NAME="CONTEXT7_API_KEY"
TENSILLM_CONTEXT7_API_KEY="replace-with-context7-key"

TENSILLM_DYNATRACE_NAME="dynatrace"
TENSILLM_DYNATRACE_URL="https://tenant.example.com/mcp"
TENSILLM_DYNATRACE_AUTHORIZATION="Bearer replace-with-dynatrace-token"

TENSILLM_SEARCH_PROVIDER="duckduckgo"
TENSILLM_SEARCH_API_KEY=""
TENSILLM_SEARCH_MAX_RESULTS="5"
TENSILLM_SEARCH_QUERY="https://opencode.ai/docs/agents/"

TENSILLM_HELLO_WORLD_NAME="hello-world"
TENSILLM_HELLO_WORLD_DESCRIPTION="replace-with-hello-world-description"
TENSILLM_HELLO_WORLD_CONTENT_B64="replace-with-base64-hello-world-content"
TENSILLM_HELLO_WORLD_QUERY="test skill"

TENSILLM_SLUGIFY_NAME="slugify"
TENSILLM_SLUGIFY_DESCRIPTION="replace-with-slugify-description"
TENSILLM_SLUGIFY_CONTENT_B64="replace-with-base64-slugify-content"
TENSILLM_SLUGIFY_QUERY="slugify: Hola Mundo! ¿Cómo Estás?"

TENSILLM_SYSTEM_PROMPT_B64="replace-with-base64-system-prompt"
TENSILLM_SYSTEM_PROMPT_QUERY="¿Cuál es mi contexto profesional actual?"

TENSILLM_CONTEXT7_TOOL="resolve-library-id"
TENSILLM_CONTEXT7_ARGUMENTS_JSON='{"libraryName":"React","query":"React hooks documentation"}'
TENSILLM_DYNATRACE_TOOL="query-problems"
TENSILLM_DYNATRACE_ARGUMENTS_JSON='{"history":"2h","status":"ALL","includeTypes":false}'
